local function f1(length)
    local charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local result = {}
    for i = 1, length do
        local rand = math.random(1, #charset)
        table.insert(result, charset:sub(rand, rand))
    end
    return table.concat(result)
end
local function gen()
    local hwid = game:GetService("RbxAnalyticsService"):GetClientId()
    local userId = game.Players.LocalPlayer.UserId
    local p1 = hwid:sub(1, hwid:find("-") - 1)
    local key = f1(8)
    local finalString = string.format("SENTINEL-%s-%d-%s", key, userId, p1)
    return finalString
end
getgenv().key = gen()
loadstring(game:HttpGet("https://raw.githubusercontent.com/Mc4121ban/Source/refs/heads/main/jun_22-1-2025.lua"))()
